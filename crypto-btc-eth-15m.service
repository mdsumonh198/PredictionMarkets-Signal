[Unit]
Description=Kalshi BTC ETH 15M Telegram Signal Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/PredictionMarkets-Signal
ExecStart=/root/PredictionMarkets-Signal/.venv/bin/python -u -m scanner.btc_eth_15m_signal --env /root/PredictionMarkets-Signal/.env --interval 20
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
