# This is a systemd EnvironmentFile template, not loaded by the Python CLI.
# Set privately; never commit the filled file or a PEM private key.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/root/.config/crypto-prediction/kalshi.pem
# Alternatively use licensed CF Benchmarks credentials for the reference feed.
CFB_USERNAME=
CFB_API_KEY=
# Use a dedicated paper testing chat.
PREDICTION_TELEGRAM_TOKEN=
PREDICTION_TELEGRAM_CHAT_ID=
